# Local vectors avoid Gemini embedding API quotas. The model is downloaded on
# first use and cached locally by Sentence Transformers.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Optional embedding provider. Switch both settings together to use Gemini.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001

# Gemini remains the independent answer-generation/evaluation provider.
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_MAX_SERVER_RETRY_SECONDS=300

# Optional production cross-encoder reranking. Keep false to use hybrid RRF only.
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_COUNT=10
RERANKER_TOP_K=5
